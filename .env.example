# Copy to .env and adjust. Every setting and credential is read from here (or the environment).
# Nothing below is required for the default run: with LLM_PROVIDERS empty the pipeline uses the
# approved reference data in config/seeds/ and the deterministic (offline) agent strategies.

# --- database (host-side tools; containers get their own DATABASE_URL from docker-compose) ---------
DATABASE_URL=postgresql://medallion:medallion@localhost:55432/medallion
# POSTGRES_PORT=55432
# API_PORT=8000

# --- LLM fallback chain: comma-separated, tried in order. Empty = offline/deterministic mode. -------
# Options: anthropic, openai, gemini, openrouter, ollama, vllm
LLM_PROVIDERS=
# Recommended: Jev Router (TypeSafe) via OpenRouter for classification and judging:
#   LLM_PROVIDERS=openrouter  OPENROUTER_MODEL=typesafe/jev-router  JUDGE=openrouter:typesafe/jev-router
# Chains work too, e.g. LLM_PROVIDERS=openrouter,ollama   (hosted first, local model as last resort)

# LLM-as-judge for auto-approval ("provider[:model]"); human feedback is weighted above it.
# JUDGE=openrouter:typesafe/jev-router

# Native Jev (TypeSafe System-One, typed choices with calibrated probabilities) for classification.
# Uses OPENROUTER_API_KEY (model typesafe/jev-1.13); a direct TypeSafe key takes precedence if set.
# CLASSIFIER_BACKEND=jev
# TYPESAFE_API_KEY=

# Anthropic (default model: claude-opus-5-5, run at low effort for classification)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# OpenAI (model must be set explicitly)
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Gemini (model must be set explicitly)
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter: one key, many hosted models (model must be set, e.g. a "vendor/model" slug)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama: local models, no key. From inside docker-compose the host is host.docker.internal.
# IMPORTANT: start Ollama with a bigger context window, e.g. `OLLAMA_CONTEXT_LENGTH=16384 ollama serve`.
# The default (2k tokens) silently drops the start of long prompts; the adapter detects that and
# refuses the answer, so with the default context the DQ / gold agents will fall through the chain.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma3:4b

# vLLM: self-hosted OpenAI-compatible server (GPU). Same adapter as Ollama.
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=
# VLLM_API_KEY=

# --- LLM resilience & cost guards --------------------------------------------------------------
# LLM_TIMEOUT_S=60
# LLM_MAX_ATTEMPTS=4              # retries with exponential backoff + full jitter
# LLM_BACKOFF_BASE_S=0.5
# LLM_BACKOFF_MAX_S=20
# ANTHROPIC_RPM=60                # client-side token-bucket rate limit per provider (<PROVIDER>_RPM)
# LLM_CONCURRENCY=4
# LLM_BATCH_SIZE=25
# LLM_MAX_TOKENS_PER_RUN=400000   # hard budget: the agent falls back to rules when exhausted
# LLM_MAX_COST_USD_PER_RUN=2.0       # USD budget per run
# LLM_AUTO_APPROVE_CONFIDENCE=0.85
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_RESET_S=30
# LLM_PRICING_JSON={"some-model": [0.5, 1.5]}   # USD per 1M input/output tokens for unpriced models

# --- data rules ---------------------------------------------------------------------------------
# DEDUP_SAFETY_BITS=3   # content dedup merges only matches too rare to be chance (see docs/CLEANING_RULES.md)

# --- API -------------------------------------------------------------------------------------------
# API_KEY=                         # when set, clients must send X-API-Key
# API_URL=http://localhost:8000    # used by `medallion submit`
# API_RATE_LIMIT_RPM=30

# --- events (optional Kafka; otherwise events stay in the ops.outbox table) -------------------------
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC=medallion.events

# --- observability ---------------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json                  # json | text
# ALERT_QUARANTINE_RATE=0.01
# ALERT_NULL_RATE_DELTA=0.05
# ALERT_LLM_FAILURE_RATE=0.2
